# ---------------------------------------------------------------- obrigatorio
ANTHROPIC_API_KEY=

# Senha do painel. Sem ela, nenhum login e aceito.
# O painel controla suas contas sociais e o acervo inteiro — use uma senha forte.
DUBFLOW_PASSWORD=

# Chave de assinatura (sessao, CSRF, URLs de media).
# Se deixar vazio, e gerada e guardada em data/.secret_key na primeira execucao.
SECRET_KEY=

# ------------------------------------------------------------------- pipeline
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
SOURCE_LANG=
TARGET_LANG=pt-BR

TRANSLATE_MODEL=claude-opus-5
TRANSLATE_EFFORT=medium
CLIP_MODEL=claude-opus-5
# Batch API: metade do preco, sem garantia de latencia. Bom para reprocessar acervo.
USE_BATCH_API=false

# --------------------------------------------------------------------- cortes
# A cota acompanha a duracao: 20/hora significa ~40 cortes num episodio de 2h.
# CLIPS_PER_EPISODE e so o piso (video curto nao volta com 2 cortes).
CLIPS_PER_HOUR=20
CLIPS_PER_EPISODE=5
CLIPS_MAX=80
# A selecao le o episodio em janelas deste tamanho, em paralelo, em vez de varrer
# 2h de uma vez — a atencao se dilui e a escolha piora.
CLIP_WINDOW_MINUTES=20
CLIP_MIN_SECONDS=25
CLIP_MAX_SECONDS=60
# Enquadramento do corte 9:16 (preenche a tela nos dois primeiros):
#   face   (padrao) recorta focando no rosto detectado
#   center recorta o centro, sem deteccao
#   pad    encaixa o video inteiro com fundo borrado (legado, nao foca na cena)
CLIP_REFRAME=face
# Legenda karaoke (palavra destacada no tempo da fala) nos cortes verticais.
CLIP_KARAOKE=true
# Renderiza tambem a versao horizontal 16:9 do corte (para postar no YouTube comum).
CLIP_RENDER_WIDE=true
# Gera thumbnail 16:9 de cada corte.
CLIP_THUMBNAIL=true
# Normaliza o volume (loudnorm -14 LUFS) para todos os cortes ficarem no mesmo nivel.
AUDIO_LOUDNORM=true

# ---------------------------------------------------------------------- video
# Queimar legenda no episodio inteiro de 1h leva ~20-40 min de GPU/CPU.
# Deixe false e use o .srt como faixa separada ate ter motivo para queimar.
BURN_FULL_EPISODE=false
MAX_HEIGHT=1080
# O audio extraido sempre e apagado apos arquivar. Marque true para apagar
# tambem o video de origem (~2 GB/episodio); mantê-lo permite re-render de cortes.
DELETE_SOURCE_AFTER_ARCHIVE=false

# ------------------------------------------------------ distribuicao automatica
# Depois de cortar, classifica o episodio por segmento e agenda os cortes nos
# canais daquele segmento (1 corte = 1 canal, em gotejamento). Sem canais
# configurados, nao faz nada.
AUTO_DISTRIBUTE=true
# Cortes por dia por canal (padrao; cada canal pode sobrescrever no painel).
DISTRIBUTE_PER_DAY=3
# Janela de postagem do dia em HORA UTC (BR = UTC-3; 12-24 UTC = 9h-21h BR).
DISTRIBUTE_START_HOUR=9
DISTRIBUTE_END_HOUR=21
# Confianca minima da classificacao para rotear sozinho; abaixo disso fica manual.
DISTRIBUTE_MIN_CONFIDENCE=0.6

# --------------------------------------------------------------------- acervo
# Aponte para a pasta sincronizada do Drive/OneDrive para backup automatico.
ARCHIVE_DIR=

# ----------------------------------------------------------------- instagram
# Conta Business/Creator vinculada a uma Pagina. Token com instagram_content_publish.
IG_USER_ID=
IG_ACCESS_TOKEN=
# URL publica deste servidor — a Meta busca o video por HTTP, nao aceita upload.
PUBLIC_BASE_URL=

# -------------------------------------------------------------------- tiktok
TIKTOK_ACCESS_TOKEN=

# ------------------------------------------------------------------- youtube
# OAuth2. Crie um projeto no Google Cloud, ative a "YouTube Data API v3" e uma
# credencial OAuth do tipo "Desktop app". Depois rode:
#   .venv\Scripts\python.exe -m scripts.youtube_auth
# e cole aqui o YOUTUBE_REFRESH_TOKEN que ele imprimir.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private (padrao) | unlisted | public — o Short sobe oculto ate voce liberar.
YOUTUBE_PRIVACY=private
# Categoria do video. 22 = People & Blogs. Veja a lista em videoCategories.list.
YOUTUBE_CATEGORY_ID=22

# ------------------------------------------------------------------ telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ----------------------------------------------------------- venda no telegram
# Pagamento manual: o bot mostra sua chave Pix, voce confirma o recebimento no
# painel e o bot entrega. Preencha a chave/nome e os precos (em reais).
PIX_KEY=
PIX_NAME=
PRICE_EPISODE=9.90
PRICE_SUBSCRIPTION=29.90
SUBSCRIPTION_DAYS=30

# -------------------------------------------------------------------- server
PORT=8030
# 127.0.0.1 = so esta maquina. Use 0.0.0.0 apenas com DUBFLOW_PASSWORD forte.
HOST=127.0.0.1
# Cookie de sessao exige HTTPS. Vazio = liga sozinho quando HOST nao e local
# (o tunel do Instagram ja da HTTPS). Deixe false so para expor em HTTP puro (raro).
COOKIE_SECURE=

# ------------------------------------------------------------------- OpenAI
# Ainda nao usada pelo pipeline — reservada para uma futura troca de provedor.
OPENAI_API_KEY=

# Ordem de preferencia dos provedores de IA. O primeiro atende; os demais cobrem
# quando ele cai (teto de gasto, sem credito, chave invalida). Com dois na lista,
# as janelas de um episodio sao repartidas e rodam ao mesmo tempo.
LLM_PROVIDERS=anthropic,openai
# Tentativas por provedor antes de passar a bola. So vale para erro transitorio:
# teto estourado nao se repete, cai para o proximo na hora.
LLM_MAX_RETRIES=3
# Chamadas simultaneas quando as tarefas sao repartidas.
LLM_MAX_PARALLEL=4
# Quanto tempo ignorar um provedor bloqueado que NAO informa a hora da liberacao.
LLM_BLOCK_COOLDOWN_MINUTES=60
OPENAI_CLIP_MODEL=gpt-5.5
OPENAI_TRANSLATE_MODEL=gpt-5.5
OPENAI_SCAN_MODEL=gpt-5.4-mini
