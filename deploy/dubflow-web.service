[Unit]
Description=dubflow — painel web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dubflow
WorkingDirectory=/opt/dubflow
Environment=PYTHONPATH=/opt/dubflow
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/dubflow/.env
ExecStart=/opt/dubflow/.venv/bin/python -m uvicorn app.web.main:app --host 127.0.0.1 --port 8030
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
